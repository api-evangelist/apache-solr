{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Solr HTTP Cluster Schema API",
    "version": "9.x"
  },
  "items": [
    {
      "info": {
        "name": "Schema",
        "type": "folder"
      },
      "items": [
